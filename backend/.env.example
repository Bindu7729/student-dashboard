# Backend environment variables
# Copy this file to .env and fill in the values

# ─── Application ───────────────────────────────────────────────────────────
APP_NAME=EduRisk AI Backend
DEBUG=false

# ─── Security ──────────────────────────────────────────────────────────────
# REQUIRED: Generate a strong secret key for production!
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ──────────────────────────────────────────────────────────────
# SQLite (default, good for single-server deployments):
DATABASE_URL=sqlite:///./student_risk.db

# PostgreSQL example (for Render / Railway with PostgreSQL addon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─── ML Model ──────────────────────────────────────────────────────────────
MODEL_PATH=../ml_models/dropout_risk_model.joblib
